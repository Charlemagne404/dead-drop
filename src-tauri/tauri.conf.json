{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dead Drop",
  "version": "0.1.0",
  "identifier": "com.continental.deaddrop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dead Drop",
        "width": 1120,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
